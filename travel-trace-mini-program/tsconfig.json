{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2020"
    ],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "/*": [
        "miniprogram/*"
      ]
    },
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "miniprogram/**/*.ts",
    "typings/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "legacy-web-demo"
  ]
}
