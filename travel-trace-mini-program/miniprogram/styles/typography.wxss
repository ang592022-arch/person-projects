.page-title,
.section-title {
  display: block;
  color: var(--color-text, #27312D);
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.22;
}

.page-subtitle,
.section-subtitle {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-secondary, #777D78);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.6;
}

.card-title {
  color: var(--color-text, #27312D);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.body-text {
  color: var(--color-text, #27312D);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.6;
}

.caption-text {
  color: var(--color-text-muted, #A3A7A3);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.5;
}
