.theme-card {
  color: var(--color-text, #27312D);
  background: var(--color-card, #FFFCF7);
  border: 1rpx solid var(--color-border, #E7E1D7);
  border-radius: var(--radius-card, 20rpx);
}

.theme-elevated {
  background: var(--color-elevated, #FFFFFF);
  box-shadow: var(--shadow-soft);
}

.theme-shadow-none {
  box-shadow: none;
}

.theme-shadow-light {
  box-shadow: var(--shadow-soft);
}

.theme-shadow-medium {
  box-shadow: 0 18rpx 48rpx rgba(49, 76, 64, 0.12);
}
