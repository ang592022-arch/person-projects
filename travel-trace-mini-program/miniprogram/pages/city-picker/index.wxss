.picker-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 24rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  color: var(--text-primary, #27312D);
  background: var(--page-background, #F5F2EB);
}

.picker-header {
  flex: 0 0 auto;
}

.picker-eyebrow,
.picker-title,
.picker-subtitle,
.section-title,
.section-meta,
.city-name,
.city-parent,
.empty-title,
.empty-copy {
  display: block;
}

.picker-eyebrow {
  color: var(--secondary, #C28E5C);
  font-size: 19rpx;
  font-weight: 600;
}

.picker-title {
  margin-top: 8rpx;
  color: var(--button-background, #496B5C);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.picker-subtitle {
  margin-top: 10rpx;
  color: var(--text-secondary, #777D78);
  font-size: 23rpx;
  line-height: 1.55;
}

.search-box {
  display: flex;
  align-items: center;
  min-height: 78rpx;
  margin-top: 22rpx;
  padding: 0 10rpx 0 22rpx;
  background: var(--card-background, #FFFCF7);
  border: 1rpx solid var(--color-border, #E7E1D7);
  border-radius: 16rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  color: var(--text-primary, #27312D);
  font-size: 26rpx;
}

.search-placeholder {
  color: var(--color-text-muted, #A3A7A3);
}

.clear-button,
.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  color: var(--text-secondary, #777D78);
  background: transparent;
}

.clear-button {
  width: 56rpx;
  height: 56rpx;
  font-size: 38rpx;
}

.content-section {
  display: flex;
  flex: 1;
  min-height: 0;
  flex-direction: column;
  margin-top: 24rpx;
}

.section-summary,
.province-summary {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  min-height: 62rpx;
  padding-bottom: 12rpx;
}

.section-title {
  color: var(--button-background, #496B5C);
  font-size: 29rpx;
  font-weight: 600;
}

.section-meta {
  margin-top: 4rpx;
  color: var(--text-secondary, #777D78);
  font-size: 21rpx;
}

.province-summary {
  justify-content: flex-start;
  gap: 14rpx;
}

.back-button {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  color: var(--primary, #496B5C);
  font-size: 52rpx;
  line-height: 1;
  background: var(--color-primary-light, #E4ECE7);
  border-radius: 16rpx;
}

.province-scroll,
.city-scroll {
  flex: 1;
  min-height: 0;
  background: var(--card-background, #FFFCF7);
  border: 1rpx solid var(--color-border, #E7E1D7);
  border-radius: 20rpx;
}

.province-section {
  position: relative;
}

.province-scroll {
  box-sizing: border-box;
  padding: 4rpx 56rpx 20rpx 0;
}

.province-group {
  padding: 0 0 0 22rpx;
}

.group-letter {
  display: block;
  padding: 20rpx 0 10rpx;
  color: var(--secondary, #C28E5C);
  font-size: 23rpx;
  font-weight: 600;
}

.province-row,
.city-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 84rpx;
  padding: 0 18rpx 0 0;
  text-align: left;
  color: var(--text-primary, #27312D);
  background: transparent;
  border-bottom: 1rpx solid var(--color-divider, #ECE7DF);
  border-radius: 0;
}

.province-name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 500;
}

.province-trailing {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-secondary, #777D78);
  font-size: 21rpx;
}

.row-arrow {
  color: var(--primary, #496B5C);
  font-size: 38rpx;
  font-weight: 300;
}

.alphabet-index {
  position: absolute;
  right: 0;
  top: 72rpx;
  bottom: 8rpx;
  z-index: 2;
  display: flex;
  width: 54rpx;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
  padding: 6rpx 0;
  background: var(--color-primary-light, #E4ECE7);
  border-radius: 12rpx;
}

.alphabet-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  min-height: 22rpx;
  padding: 0;
  color: var(--button-background, #496B5C);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  background: transparent;
}

.alphabet-letter.disabled {
  color: var(--color-text-muted, #A3A7A3);
  opacity: 0.36;
}

.city-row {
  min-height: 96rpx;
  padding: 12rpx 22rpx;
}

.city-row.visited {
  background: var(--color-primary-light, #E4ECE7);
}

.city-copy {
  flex: 1;
  min-width: 0;
}

.city-name {
  font-size: 27rpx;
  font-weight: 600;
}

.city-parent {
  margin-top: 5rpx;
  color: var(--text-secondary, #777D78);
  font-size: 20rpx;
}

.city-status {
  flex: 0 0 auto;
  margin-left: 20rpx;
  padding: 9rpx 14rpx;
  color: var(--primary, #496B5C);
  font-size: 21rpx;
  font-weight: 600;
  background: var(--color-primary-light, #E4ECE7);
  border-radius: 999rpx;
}

.city-row.visited .city-status {
  color: var(--button-text, #FFFCF7);
  background: var(--visited-region, #658875);
}

.search-empty {
  display: flex;
  flex: 1;
  min-height: 280rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  background: var(--card-background, #FFFCF7);
  border: 1rpx solid var(--color-border, #E7E1D7);
  border-radius: 20rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 10rpx;
  color: var(--text-secondary, #777D78);
  font-size: 22rpx;
  line-height: 1.55;
}

.picker-footer {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 18rpx;
}

.visited-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.visited-number {
  color: var(--primary, #496B5C);
  font-size: 36rpx;
  font-weight: 600;
}

.visited-label {
  color: var(--text-secondary, #777D78);
  font-size: 22rpx;
}

.finish-button {
  min-width: 190rpx;
  min-height: 72rpx;
  padding: 0 30rpx;
  color: var(--button-text, #FFFCF7);
  font-size: 25rpx;
  font-weight: 600;
  background: var(--button-background, #496B5C);
  border-radius: 18rpx;
}

.clear-button::after,
.back-button::after,
.province-row::after,
.city-row::after,
.finish-button::after {
  border: 0;
}

.clear-button:active,
.back-button:active,
.province-row:active,
.city-row:active,
.finish-button:active {
  opacity: 0.86;
  transform: scale(0.98);
}

@media (max-width: 340px) {
  .picker-page {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .picker-title {
    font-size: 36rpx;
  }

  .picker-subtitle {
    font-size: 21rpx;
  }
}
