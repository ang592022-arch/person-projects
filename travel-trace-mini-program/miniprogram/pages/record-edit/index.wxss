.edit-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.head {
  position: relative;
  display: grid;
  gap: 10rpx;
  padding: 34rpx;
  overflow: hidden;
}

.head::after {
  position: absolute;
  right: -46rpx;
  top: -54rpx;
  width: 180rpx;
  height: 180rpx;
  content: "";
  background: var(--color-accent-light, #F2E7DA);
  border-radius: 50%;
  opacity: 0.8;
}

.eyebrow {
  position: relative;
  z-index: 1;
  color: var(--color-accent, #C28E5C);
  font-size: 22rpx;
  font-weight: 500;
}

.form {
  display: grid;
  gap: 22rpx;
}

.field {
  display: grid;
  gap: 14rpx;
  padding: 26rpx;
}

.privacy-field {
  gap: 20rpx;
}

.privacy-copy {
  display: grid;
  gap: 10rpx;
}

.privacy-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  justify-self: start;
  min-height: 64rpx;
  padding: 0 18rpx;
  color: var(--color-text-secondary, #777D78);
  font-size: 24rpx;
  font-weight: 600;
  background: var(--color-primary-light, #E4ECE7);
  border: 1rpx solid var(--color-border, #E7E1D7);
  border-radius: 999rpx;
}

.privacy-toggle-dot {
  width: 18rpx;
  height: 18rpx;
  background: var(--color-text-muted, #A3A7A3);
  border-radius: 50%;
}

.privacy-toggle.active {
  color: var(--button-text, #FFFCF7);
  background: var(--button-background, #496B5C);
  border-color: var(--button-background, #496B5C);
}

.privacy-toggle.active .privacy-toggle-dot {
  background: var(--color-accent-light, #F2E7DA);
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.label {
  color: var(--color-text, #27312D);
  font-size: 26rpx;
  font-weight: 600;
}

.hint {
  color: var(--color-text-secondary, #777D78);
  font-size: 23rpx;
  line-height: 1.55;
}

input,
textarea,
.picker-value {
  width: 100%;
  color: var(--color-text, #27312D);
  font-size: 28rpx;
  background: var(--color-elevated, #FFFFFF);
  border: 1rpx solid var(--color-border, #E7E1D7);
  border-radius: var(--radius-input, 16rpx);
}

input,
.picker-value {
  min-height: 84rpx;
  padding: 0 22rpx;
  line-height: 84rpx;
}

textarea {
  min-height: 280rpx;
  padding: 22rpx;
  line-height: 1.6;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.photo,
.add-photo {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  background: var(--color-primary-light, #E4ECE7);
  border: 1rpx solid var(--color-border, #E7E1D7);
  border-radius: var(--radius-button, 18rpx);
}

.photo image {
  width: 100%;
  height: 100%;
}

.video-thumb {
  display: grid;
  align-content: center;
  justify-items: center;
  width: 100%;
  height: 100%;
  color: var(--button-text, #FFFCF7);
  background: var(--color-primary, #496B5C);
}

.video-icon {
  display: block;
  font-size: 42rpx;
  line-height: 1;
}

.video-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.remove-photo {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  color: var(--button-text, #FFFCF7);
  font-size: 32rpx;
  line-height: 40rpx;
  background: rgba(39, 49, 45, 0.72);
  border-radius: 999rpx;
}

.add-photo {
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 6rpx;
  color: var(--color-primary, #496B5C);
  border: 2rpx dashed rgba(73, 107, 92, 0.32);
}

.add-icon {
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.add-label {
  font-size: 22rpx;
}

.mini-button,
.remove-ticket {
  min-width: 116rpx;
  min-height: 56rpx;
  color: var(--button-text, #FFFCF7);
  font-size: 24rpx;
  font-weight: 600;
  background: var(--color-primary, #496B5C);
  border-radius: var(--radius-button, 18rpx);
}

.ticket-empty {
  color: var(--color-text-secondary, #777D78);
  font-size: 24rpx;
  line-height: 1.5;
}

.ticket-card {
  display: grid;
  gap: 14rpx;
  padding: 18rpx;
  background: var(--color-accent-light, #F2E7DA);
  border: 1rpx solid rgba(194, 142, 92, 0.18);
  border-radius: var(--radius-card, 20rpx);
}

.ticket-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.picker-value.compact {
  min-width: 160rpx;
  min-height: 62rpx;
  line-height: 62rpx;
}

.remove-ticket {
  color: var(--color-danger, #B86B63);
  background: rgba(184, 107, 99, 0.1);
}

.ticket-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 16rpx;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(245, 242, 235, 0.94);
  border-top: 1rpx solid var(--color-divider, #ECE7DF);
}

.danger-button {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  color: var(--color-danger, #B86B63);
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(184, 107, 99, 0.1);
  border: 1rpx solid rgba(184, 107, 99, 0.22);
  border-radius: var(--radius-button, 18rpx);
}
