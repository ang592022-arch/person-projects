.home-page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(174rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  color: var(--text-primary, #27312D);
  background: var(--page-background, #F5F2EB);
}

.hero-cover {
  position: relative;
  min-height: 520rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 252, 247, 0.34);
  border-radius: 24rpx;
  background: var(--primary, #496B5C);
}

.hero-image,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background:
    linear-gradient(180deg, rgba(28, 42, 36, 0.26) 0%, rgba(28, 42, 36, 0.08) 34%, rgba(28, 42, 36, 0.76) 100%);
}

.hero-toolbar,
.hero-copy,
.import-entry {
  position: absolute;
  z-index: 1;
}

.hero-toolbar {
  left: 26rpx;
  right: 26rpx;
  top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  color: #314C40;
  font-size: 28rpx;
  font-weight: 600;
  background: rgba(255, 252, 247, 0.92);
  border: 1rpx solid rgba(255, 252, 247, 0.56);
  border-radius: 18rpx;
}

.brand-copy {
  display: grid;
  gap: 3rpx;
  color: #FFFCF7;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 600;
}

.brand-en {
  font-size: 17rpx;
  font-weight: 500;
  letter-spacing: 0;
  opacity: 0.78;
}

.import-entry:active,
.map-action:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.hero-copy {
  left: 30rpx;
  right: 30rpx;
  top: 150rpx;
  color: #FFFCF7;
}

.hero-eyebrow,
.hero-title,
.hero-meta {
  display: block;
}

.hero-eyebrow {
  font-size: 24rpx;
  font-weight: 500;
  opacity: 0.84;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.25;
}

.hero-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  opacity: 0.84;
}

.import-entry {
  left: 24rpx;
  right: 24rpx;
  bottom: 22rpx;
  display: flex;
  align-items: center;
  min-height: 94rpx;
  padding: 14rpx 18rpx;
  text-align: left;
  color: #FFFCF7;
  background: rgba(39, 49, 45, 0.62);
  border: 1rpx solid rgba(255, 252, 247, 0.30);
  border-radius: 18rpx;
  transition: transform 120ms, opacity 120ms;
}

.import-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  color: #314C40;
  font-size: 24rpx;
  font-weight: 600;
  background: #F2E7DA;
  border-radius: 14rpx;
}

.import-text {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.import-title,
.import-copy {
  display: block;
}

.import-title {
  font-size: 26rpx;
  font-weight: 600;
}

.import-copy {
  margin-top: 7rpx;
  font-size: 21rpx;
  opacity: 0.74;
}

.import-arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 40rpx;
  font-weight: 300;
  opacity: 0.72;
}

.map-section {
  margin-top: 28rpx;
  padding: 28rpx;
}

.map-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.section-kicker,
.map-title,
.map-subtitle {
  display: block;
}

.section-kicker {
  color: var(--secondary, #C28E5C);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.map-title {
  margin-top: 7rpx;
  color: var(--text-primary, #27312D);
  font-size: 34rpx;
  font-weight: 600;
}

.map-subtitle {
  margin-top: 8rpx;
  color: var(--text-secondary, #777D78);
  font-size: 22rpx;
  line-height: 1.45;
}

.map-level-badge {
  flex: 0 0 auto;
  padding: 9rpx 16rpx;
  color: var(--primary, #496B5C);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--color-primary-light, #E4ECE7);
  border-radius: 999rpx;
}

.map-stage {
  position: relative;
  height: 500rpx;
  margin-top: 18rpx;
  overflow: hidden;
  background: var(--map-background, #EEF1EC);
  border: 1rpx solid var(--map-border, #C8CFC7);
  border-radius: 20rpx;
}

.home-map-board {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 10rpx;
  bottom: 92rpx;
}

.map-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 16rpx 22rpx;
  color: var(--text-primary, #27312D);
  background: var(--card-background, #FFFCF7);
  border-top: 1rpx solid var(--color-divider, #ECE7DF);
}

.map-caption-title,
.map-caption-copy {
  display: block;
}

.map-caption-title {
  font-size: 25rpx;
  font-weight: 600;
}

.map-caption-copy {
  margin-top: 6rpx;
  color: var(--text-secondary, #777D78);
  font-size: 20rpx;
}

.map-caption-arrow {
  color: var(--secondary, #C28E5C);
  font-size: 42rpx;
  font-weight: 300;
}

.map-actions {
  display: grid;
  grid-template-columns: 0.88fr 1.35fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.map-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-width: 0;
  min-height: 76rpx;
  padding: 0 18rpx;
  font-size: 25rpx;
  font-weight: 600;
  border-radius: 18rpx;
  transition: transform 120ms, opacity 120ms;
}

.map-action.secondary {
  color: var(--primary, #496B5C);
  background: var(--color-primary-light, #E4ECE7);
  border: 1rpx solid rgba(73, 107, 92, 0.12);
}

.map-action.primary {
  color: var(--button-text, #FFFCF7);
  background: var(--button-background, #496B5C);
}

.map-action-pressed {
  opacity: 0.86;
  transform: scale(0.98);
}

.add-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  color: var(--button-background, #496B5C);
  font-size: 28rpx;
  line-height: 1;
  background: var(--button-text, #FFFCF7);
  border-radius: 10rpx;
}

.timeline {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: stretch;
  gap: 8rpx;
  margin-top: 34rpx;
  color: var(--text-secondary, #777D78);
}

.timeline-year {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-width: 0;
  min-height: 72rpx;
  color: var(--color-text-muted, #A3A7A3);
  font-size: 30rpx;
  font-weight: 500;
}

.timeline-year.active {
  color: var(--primary, #496B5C);
}

.timeline-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin-top: 5rpx;
  color: var(--button-text, #FFFCF7);
  font-size: 18rpx;
  font-weight: 600;
  background: var(--secondary, #C28E5C);
  border-radius: 999rpx;
}

.timeline .all {
  align-self: end;
  color: var(--text-primary, #27312D);
  font-size: 34rpx;
  font-weight: 600;
  text-align: right;
}

.ticks {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.tick {
  width: 3rpx;
  height: 16rpx;
  background: var(--map-border, #C8CFC7);
  opacity: 0.68;
}

.tick.major {
  height: 26rpx;
  background: var(--secondary, #C28E5C);
  opacity: 1;
}

.stats-panel {
  margin-top: 32rpx;
  padding: 28rpx;
}

.stats-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  color: var(--text-primary, #27312D);
  font-size: 27rpx;
  font-weight: 600;
}

.distance-box {
  display: grid;
  gap: 5rpx;
  text-align: right;
}

.distance {
  color: var(--secondary, #C28E5C);
  font-size: 24rpx;
  font-weight: 600;
}

.distance-hint {
  color: var(--text-secondary, #777D78);
  font-size: 20rpx;
  font-weight: 400;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 26rpx;
  text-align: center;
}

.stats-grid > view + view {
  border-left: 1rpx solid var(--color-divider, #ECE7DF);
}

.stat-number {
  display: block;
  color: var(--primary, #496B5C);
  font-size: 42rpx;
  font-weight: 600;
}

.stat-label {
  display: block;
  margin-top: 7rpx;
  color: var(--text-secondary, #777D78);
  font-size: 22rpx;
}

.home-places {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-divider, #ECE7DF);
}

.home-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 50rpx;
  padding: 0 16rpx;
  color: var(--primary, #496B5C);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--color-primary-light, #E4ECE7);
  border: 1rpx solid rgba(73, 107, 92, 0.12);
  border-radius: 999rpx;
}

.home-dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--secondary, #C28E5C);
  border-radius: 50%;
}

.home-empty {
  color: var(--text-secondary, #777D78);
  font-size: 23rpx;
  line-height: 1.55;
}

.section-heading {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 24rpx;
  margin: 44rpx 0 22rpx;
  color: var(--text-primary, #27312D);
  font-size: 30rpx;
  font-weight: 600;
}

.section-heading view {
  height: 1rpx;
  background: var(--color-divider, #ECE7DF);
}

.photo-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.photo-card {
  position: relative;
  display: block;
  width: 100%;
  min-height: 210rpx;
  overflow: hidden;
  padding: 14rpx;
  text-align: left;
  background: var(--visited-region, #658875);
  border-radius: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(49, 76, 64, 0.10);
}

.photo-card.palace {
  background: var(--secondary, #C28E5C);
}

.photo-card.mountain {
  background: var(--primary, #496B5C);
}

.photo-cover,
.photo-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.photo-mask {
  background: linear-gradient(180deg, rgba(39, 49, 45, 0.02), rgba(39, 49, 45, 0.76));
}

.photo-content {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 182rpx;
  flex-direction: column;
}

.year {
  color: #FFFCF7;
  font-size: 31rpx;
  font-weight: 500;
}

.photo-title {
  margin-top: auto;
  color: #FFFCF7;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.photo-place,
.photo-date {
  display: block;
  margin-top: 5rpx;
  color: rgba(255, 252, 247, 0.80);
  font-size: 18rpx;
  line-height: 1.3;
}

.photo-empty {
  grid-column: 1 / -1;
  padding: 28rpx;
}

.empty-title,
.empty-copy {
  display: block;
}

.empty-title {
  color: var(--text-primary, #27312D);
  font-size: 28rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 9rpx;
  color: var(--text-secondary, #777D78);
  font-size: 23rpx;
  line-height: 1.55;
}

.stats-link {
  width: 100%;
  min-height: 74rpx;
  margin-top: 22rpx;
  color: var(--primary, #496B5C);
  font-size: 25rpx;
  font-weight: 600;
  background: var(--color-primary-light, #E4ECE7);
  border: 1rpx solid rgba(73, 107, 92, 0.12);
  border-radius: 18rpx;
}

@media (max-width: 340px) {
  .home-page {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .hero-title {
    font-size: 38rpx;
  }

  .map-section {
    padding: 22rpx;
  }

  .map-action {
    font-size: 23rpx;
  }
}
