.timeline-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.summary-card {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
}

.summary-value {
  display: block;
  color: var(--color-primary, #496B5C);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1;
}

.summary-label {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-secondary, #777D78);
  font-size: 24rpx;
}

.summary-divider {
  width: 1rpx;
  height: 68rpx;
  background: var(--color-divider, #ECE7DF);
}

.loading-card {
  display: grid;
  gap: 18rpx;
  padding: 28rpx;
}

.loading-line {
  width: 72%;
  height: 24rpx;
  background: linear-gradient(90deg, var(--color-divider, #ECE7DF), var(--color-primary-light, #E4ECE7), var(--color-divider, #ECE7DF));
  border-radius: var(--radius-pill, 999rpx);
}

.loading-line.wide {
  width: 100%;
  height: 120rpx;
  border-radius: var(--radius-card, 20rpx);
}

.loading-line.short {
  width: 46%;
}

.year-list,
.record-list {
  display: grid;
  gap: 26rpx;
}

.year-group {
  display: grid;
  gap: 18rpx;
}

.year-head {
  display: grid;
  gap: 6rpx;
  padding: 0 4rpx;
}

.year {
  color: var(--color-primary-dark, #314C40);
  font-size: 44rpx;
  font-weight: 600;
}

.year-summary {
  color: var(--color-text-secondary, #777D78);
  font-size: 24rpx;
  line-height: 1.5;
}

.record-card {
  position: relative;
  display: grid;
  grid-template-columns: 168rpx 1fr;
  gap: 22rpx;
  width: 100%;
  padding: 22rpx;
  text-align: left;
}

.record-dot {
  position: absolute;
  left: -8rpx;
  top: 36rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--color-accent, #C28E5C);
  border: 4rpx solid var(--color-card, #FFFCF7);
  border-radius: 50%;
}

.record-cover {
  width: 168rpx;
  height: 168rpx;
  overflow: hidden;
  background: var(--color-primary-light, #E4ECE7);
  border-radius: var(--radius-button, 18rpx);
}

.record-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary, #496B5C);
  font-size: 48rpx;
  font-weight: 600;
}

.record-body {
  min-width: 0;
}

.record-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--color-text-muted, #A3A7A3);
  font-size: 22rpx;
}

.record-title {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text, #27312D);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.record-place,
.record-content {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary, #777D78);
  font-size: 24rpx;
  line-height: 1.5;
}

.record-content {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 6rpx 12rpx;
  color: var(--color-primary, #496B5C);
  font-size: 22rpx;
  background: var(--color-primary-light, #E4ECE7);
  border-radius: var(--radius-pill, 999rpx);
}
