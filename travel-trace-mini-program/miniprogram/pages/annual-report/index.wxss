.report-page {
  display: grid;
  gap: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.report-cover {
  position: relative;
  display: grid;
  min-height: 380rpx;
  align-content: end;
  padding: 34rpx;
  overflow: hidden;
  color: #FFFCF7;
  background: var(--color-primary-dark, #314C40);
  border-radius: 24rpx;
}

.report-cover::before {
  position: absolute;
  left: -80rpx;
  top: -120rpx;
  width: 520rpx;
  height: 260rpx;
  content: '';
  border: 2rpx solid rgba(255, 252, 247, 0.16);
  border-radius: 50%;
  transform: rotate(-12deg);
}

.report-kicker,
.report-year,
.report-title {
  position: relative;
  z-index: 1;
  display: block;
}

.report-kicker {
  font-size: 19rpx;
  font-weight: 600;
  opacity: 0.68;
}

.report-year {
  margin-top: 8rpx;
  font-size: 86rpx;
  font-weight: 600;
  line-height: 1;
}

.report-title {
  margin-top: 16rpx;
  font-size: 29rpx;
  font-weight: 500;
}

.year-picker {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  z-index: 2;
  padding: 12rpx 18rpx;
  color: #FFFCF7;
  font-size: 22rpx;
  background: rgba(255, 252, 247, 0.12);
  border: 1rpx solid rgba(255, 252, 247, 0.24);
  border-radius: 999rpx;
}

.summary-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx;
}

.summary-main {
  min-width: 160rpx;
  padding-right: 28rpx;
  border-right: 1rpx solid var(--color-divider, #ECE7DF);
}

.summary-number,
.summary-label,
.summary-copy text {
  display: block;
}

.summary-number {
  color: var(--color-primary, #496B5C);
  font-size: 58rpx;
  font-weight: 600;
}

.summary-label,
.summary-copy {
  color: var(--color-text-secondary, #777D78);
  font-size: 23rpx;
  line-height: 1.7;
}

.region-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.region-stat {
  min-width: 0;
  padding: 22rpx 10rpx;
  text-align: center;
}

.region-stat text {
  display: block;
}

.region-stat text:first-child {
  color: var(--color-primary, #496B5C);
  font-size: 38rpx;
  font-weight: 600;
}

.region-stat text:last-child {
  margin-top: 7rpx;
  color: var(--color-text-secondary, #777D78);
  font-size: 19rpx;
}

.highlight-card,
.journey-list {
  display: grid;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 28rpx;
}

.block-kicker {
  color: var(--color-accent, #C28E5C);
  font-size: 19rpx;
  font-weight: 600;
}

.highlight-name {
  color: var(--color-text, #27312D);
  font-size: 42rpx;
  font-weight: 600;
}

.highlight-copy,
.journey-title {
  color: var(--color-text-secondary, #777D78);
  font-size: 23rpx;
  line-height: 1.55;
}

.block-title {
  color: var(--color-text, #27312D);
  font-size: 30rpx;
  font-weight: 600;
}

.journey-item {
  display: grid;
  grid-template-columns: 160rpx 1fr;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--color-divider, #ECE7DF);
}

.journey-date,
.journey-place,
.journey-title {
  display: block;
}

.journey-date {
  color: var(--color-accent, #C28E5C);
  font-size: 21rpx;
  font-weight: 600;
}

.journey-place {
  color: var(--color-text, #27312D);
  font-size: 25rpx;
  font-weight: 600;
}

@media (max-width: 340px) {
  .region-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
