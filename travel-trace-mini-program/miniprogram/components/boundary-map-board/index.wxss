.map-board {
  overflow: hidden;
  background: var(--card-background, #FFFCF7);
  border: 1rpx solid var(--map-border, #E7E1D7);
  border-radius: var(--card-radius, 20rpx);
  box-shadow: inset 0 0 44rpx rgba(49, 76, 64, 0.04);
}

.map-board.compact {
  height: 100%;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.map-head {
  padding: 28rpx 28rpx 8rpx;
}

.map-title {
  display: block;
  color: var(--text-primary, #27312D);
  font-size: 38rpx;
  font-weight: 600;
}

.map-subtitle {
  display: block;
  margin-top: 10rpx;
  color: var(--text-secondary, #777D78);
  font-size: 26rpx;
  line-height: 1.5;
}

.map-canvas {
  position: relative;
  height: 74vw;
  max-height: 760rpx;
  min-height: 430rpx;
  margin: 20rpx;
  overflow: hidden;
  background: var(--map-background, #E4ECE7);
  border: 1rpx solid var(--map-border, #D6DED7);
  border-radius: var(--card-radius, 20rpx);
}

.compact .map-canvas {
  height: 100%;
  max-height: none;
  min-height: 0;
  margin: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
}

.boundary-canvas {
  width: 100%;
  height: 100%;
}

.missing-boundary {
  display: grid;
  gap: 12rpx;
  margin: 20rpx;
  padding: 28rpx;
  color: var(--text-secondary, #777D78);
  background: var(--map-background, #E4ECE7);
  border: 2rpx dashed var(--map-border, #D6DED7);
  border-radius: var(--card-radius, 20rpx);
}

.missing-title {
  display: block;
  color: var(--text-primary, #27312D);
  font-size: 30rpx;
  font-weight: 600;
}

.missing-copy {
  display: block;
  color: var(--text-secondary, #777D78);
  font-size: 26rpx;
  line-height: 1.6;
}

.region-label {
  position: absolute;
  z-index: 2;
  max-width: 120rpx;
  color: var(--text-primary, #27312D);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  transform: translate(-50%, -50%);
}

.region-label-lit {
  color: var(--selected-region, #304D40);
}

.map-marker {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
  transform: translate(-50%, -50%);
}

.map-marker::before {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  content: '';
  background: var(--selected-region, rgba(48, 77, 64, 0.18));
  opacity: 0.22;
  border-radius: 50%;
}

.map-marker-core {
  position: relative;
  width: 12rpx;
  height: 12rpx;
  background: var(--selected-region, #304D40);
  border: 2rpx solid rgba(255, 252, 247, 0.95);
  border-radius: 50%;
  box-shadow: 0 0 18rpx var(--selected-region, rgba(48, 77, 64, 0.42));
}

.map-marker-lit .map-marker-core {
  background: var(--visited-region, #658875);
  box-shadow: 0 0 18rpx var(--visited-region, rgba(101, 136, 117, 0.42));
}

.map-marker-count {
  position: absolute;
  left: 18rpx;
  top: -16rpx;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 6rpx;
  color: var(--button-text, #FFFCF7);
  font-size: 18rpx;
  font-weight: 600;
  line-height: 26rpx;
  text-align: center;
  background: var(--selected-region, #304D40);
  border-radius: 13rpx;
}

.region-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 20rpx 24rpx;
}

.region-chip {
  min-height: 56rpx;
  padding: 0 18rpx;
  color: var(--text-primary, #27312D);
  font-size: 24rpx;
  font-weight: 500;
  background: var(--color-elevated, #FFFFFF);
  border: 1rpx solid var(--map-border, #D6DED7);
  border-radius: var(--radius-pill, 999rpx);
}

.region-chip-lit {
  color: var(--button-text, #FFFCF7);
  background: var(--visited-region, #658875);
  border-color: var(--selected-region, #304D40);
}
