.map-board {
  overflow: hidden;
  background: #fffaf0;
  border: 2rpx solid #eadcc7;
  border-radius: 12rpx;
}

.map-head {
  padding: 28rpx 28rpx 8rpx;
}

.map-title {
  display: block;
  color: #253337;
  font-size: 38rpx;
  font-weight: 800;
}

.map-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7c6f61;
  font-size: 26rpx;
  line-height: 1.5;
}

.map-canvas {
  position: relative;
  height: 74vw;
  max-height: 760rpx;
  min-height: 430rpx;
  margin: 20rpx;
  overflow: hidden;
  background: #cfe4e7;
  border: 2rpx solid rgba(44, 108, 115, 0.18);
}

.map-canvas::before {
  position: absolute;
  inset: 0;
  content: "";
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.35) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.35) 2rpx, transparent 2rpx);
  background-size: 25% 25%;
}

.region {
  position: absolute;
  z-index: 1;
  background: #e6ebd8;
  border: 2rpx solid #8b9a7b;
}

.region-lit {
  background: #f6b846;
  border-color: #d66945;
  box-shadow: 0 0 26rpx rgba(246, 184, 70, 0.72);
}

.region-label {
  position: absolute;
  z-index: 2;
  max-width: 120rpx;
  color: #24353a;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.region-label-lit {
  color: #5f2d1e;
}

.region-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 20rpx 24rpx;
}

.region-chip {
  min-height: 56rpx;
  padding: 0 18rpx;
  color: #4e5f5f;
  font-size: 24rpx;
  font-weight: 700;
  background: #f4f1e7;
  border: 2rpx solid #e4dccb;
  border-radius: 8rpx;
}

.region-chip-lit {
  color: #6a341f;
  background: #ffe1a3;
  border-color: #f0b65c;
}
