.empty-state {
  display: grid;
  justify-items: center;
  gap: 16rpx;
  padding: 54rpx 36rpx;
  text-align: center;
  background: var(--color-card, #FFFCF7);
  border: 1rpx solid var(--color-border, #E7E1D7);
  border-radius: var(--radius-large, 24rpx);
}

.illustration {
  position: relative;
  width: 156rpx;
  height: 92rpx;
}

.map-line {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  height: 2rpx;
  background: var(--color-divider, #ECE7DF);
}

.map-line.one {
  top: 30rpx;
  transform: rotate(-8deg);
}

.map-line.two {
  top: 58rpx;
  transform: rotate(7deg);
}

.pin {
  position: absolute;
  left: 66rpx;
  top: 18rpx;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid var(--color-primary, #496B5C);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.title {
  color: var(--color-text, #27312D);
  font-size: 30rpx;
  font-weight: 600;
}

.description {
  max-width: 480rpx;
  color: var(--color-text-secondary, #777D78);
  font-size: 25rpx;
  line-height: 1.6;
}

.action {
  min-height: 68rpx;
  margin-top: 6rpx;
  padding: 0 26rpx;
  color: var(--color-primary, #496B5C);
  font-size: 25rpx;
  font-weight: 500;
  background: var(--color-primary-light, #E4ECE7);
  border-radius: var(--radius-button, 18rpx);
}
