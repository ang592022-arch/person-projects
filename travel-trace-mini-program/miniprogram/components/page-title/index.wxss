.page-title-block {
  display: grid;
  gap: 8rpx;
}

.align-center {
  text-align: center;
}

.eyebrow {
  color: var(--color-accent, #C28E5C);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.title {
  color: var(--color-text, #27312D);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.22;
}

.subtitle {
  color: var(--color-text-secondary, #777D78);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.6;
}
