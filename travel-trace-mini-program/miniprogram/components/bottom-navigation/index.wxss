.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-bottom-nav, 50);
  display: flex;
  width: auto;
  max-width: none;
  gap: 4rpx;
  padding: 10rpx 20rpx calc(10rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  box-sizing: border-box;
  background: var(--card-background, #FFFCF7);
  border-top: 1rpx solid var(--color-divider, #ECE7DF);
  box-shadow: 0 -8rpx 28rpx rgba(49, 76, 64, 0.06);
}

.nav-item {
  display: grid;
  flex: 1 1 0;
  justify-items: center;
  gap: 6rpx;
  width: 0;
  min-width: 0;
  min-height: 74rpx;
  margin: 0;
  padding: 0 4rpx;
  color: var(--color-text-muted, #A3A7A3);
  background: transparent;
  border-radius: var(--radius-button, 18rpx);
  transition: transform var(--duration-fast, 120ms), color var(--duration-fast, 120ms), background-color var(--duration-normal, 200ms);
}

.nav-item:active {
  transform: scale(0.96);
}

.icon {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}

.label {
  max-width: 100%;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active {
  color: var(--color-primary, #496B5C);
}

.featured {
  min-height: 68rpx;
  width: 0;
  margin: 3rpx 6rpx;
  color: var(--button-text, #FFFCF7);
  background: var(--button-background, #496B5C);
  box-shadow: 0 6rpx 18rpx rgba(49, 76, 64, 0.14);
}

.featured.active {
  color: var(--button-text, #FFFCF7);
}
